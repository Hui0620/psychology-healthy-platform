/* app.wxss - 全局样式 */
page {
    background-color: #f5f5f5;
    font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
  }
  
  .container {
    padding: 20rpx;
  }
  
  /* 登录页样式 */
  .login-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 100rpx 40rpx;
  }
  
  .logo {
    width: 200rpx;
    height: 200rpx;
    margin-bottom: 40rpx;
  }
  
  .title {
    font-size: 40rpx;
    font-weight: bold;
    margin-bottom: 80rpx;
    color: #333;
  }
  
  .login-btn {
    background-color: #07c160;
    color: white;
    border-radius: 50rpx;
    width: 300rpx;
    margin-bottom: 40rpx;
  }
  
  .picker {
    padding: 20rpx;
    background: white;
    border-radius: 10rpx;
    width: 300rpx;
    text-align: center;
  }
  
  /* 首页样式 */
  .header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 30rpx;
    color: #666;
  }
  
  .student-card {
    display: flex;
    align-items: center;
    background: white;
    border-radius: 16rpx;
    padding: 30rpx;
    margin-bottom: 20rpx;
    box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
  }
  
  .avatar {
    width: 120rpx;
    height: 120rpx;
    border-radius: 50%;
    margin-right: 30rpx;
  }
  
  .info {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  
  .name {
    font-size: 36rpx;
    font-weight: bold;
    margin-bottom: 10rpx;
  }
  
  .class {
    font-size: 28rpx;
    color: #666;
    margin-bottom: 15rpx;
  }
  
  .status {
    display: flex;
    align-items: center;
  }
  
  .tag {
    padding: 6rpx 16rpx;
    border-radius: 20rpx;
    font-size: 24rpx;
    margin-left: 10rpx;
  }
  
  .tag.good { background: #e6f7ff; color: #1890ff; }
  .tag.normal { background: #f6ffed; color: #52c41a; }
  .tag.concern { background: #fff7e6; color: #fa8c16; }
  .tag.warning { background: #fff1f0; color: #f5222d; }
  
  .arrow {
    width: 40rpx;
    height: 40rpx;
  }
  
  /* 详情页样式 */
  .detail-container {
    padding: 30rpx;
  }
  
  .student-header {
    display: flex;
    background: white;
    border-radius: 16rpx;
    padding: 40rpx;
    margin-bottom: 30rpx;
  }
  
  .student-header .avatar {
    width: 150rpx;
    height: 150rpx;
  }
  
  .section {
    background: white;
    border-radius: 16rpx;
    padding: 30rpx;
    margin-bottom: 30rpx;
  }
  
  .section-title {
    display: flex;
    align-items: center;
    font-size: 32rpx;
    font-weight: bold;
    margin-bottom: 30rpx;
  }
  
  .icon {
    width: 40rpx;
    height: 40rpx;
    margin-right: 15rpx;
  }
  
  .chart {
    width: 100%;
    height: 500rpx;
  }
  
  .report-card {
    border-top: 1rpx solid #eee;
    padding-top: 30rpx;
  }
  
  .report-item {
    display: flex;
    justify-content: space-between;
    margin-bottom: 20rpx;
    font-size: 28rpx;
  }
  
  .score {
    font-weight: bold;
    color: #07c160;
  }
  
  .report-content {
    margin-top: 30rpx;
    padding-top: 30rpx;
    border-top: 1rpx dashed #eee;
  }
  
  .comment {
    display: block;
    margin-top: 20rpx;
    line-height: 1.6;
    color: #666;
  }

  button {
    margin: 0;
    padding: 0;
    background-color: transparent;
    border: none;
    border-radius: 0;
    line-height: 1;
  }
  
  button::after {
    border: none;
  }
  
  /* 学生评论弹窗按钮样式 */
  .comment-popup .cancel-btn,
  .comment-popup .submit-btn,
  .post-popup .cancel-btn,
  .post-popup .submit-btn {
    margin: 0 15rpx;
    width: calc(50% - 30rpx);
  }