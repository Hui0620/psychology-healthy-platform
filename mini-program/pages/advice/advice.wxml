<!-- health/pages/advice/advice.wxml -->
<view class="advice-container">
  <!-- 顶部信息栏 -->
  <view class="top-bar">
    <text class="welcome">你好，{{userName}}</text>
    <image src="/images/icon_post.png" class="post-btn" bindtap="openPostPopup" />
  </view>
  
  <!-- 心理建议列表 -->
  <view class="advice-list">
    <block wx:for="{{adviceList}}" wx:key="id">
      <view class="advice-card">
        <view class="card-header">
          <text class="category-tag">{{item.category}}</text>
          <text class="title">{{item.title}}</text>
        </view>
        
        <view class="card-content">
          <text class="content">{{item.content}}</text>
        </view>
        
        <!-- 操作功能区 -->
        <view class="card-footer">
          <view class="action" bindtap="addToFavorites" data-id="{{item.id}}">
            <image src="/images/icon_collect.png" class="action-icon" />
            <text>收藏</text>
          </view>
          
          <view class="action" bindtap="openComment" data-id="{{item.id}}">
            <image src="/images/icon_comment.png" class="action-icon" />
            <text>评论</text>
          </view>
          
          <view class="action" bindtap="onShareTap" data-id="{{item.id}}">
            <image src="/images/icon_share.png" class="action-icon" />
            <text>分享</text>
          </view>
        </view>
        
        <!-- 评论预览 -->
        <view wx:if="{{item.comments && item.comments.length > 0}}" class="comments-preview">
          <view class="comment-item" wx:for="{{item.comments.slice(0, 2)}}" wx:key="id">
            <image src="{{item.avatar}}" class="comment-avatar" />
            <view class="comment-content">
              <text class="comment-user">{{item.user}}</text>
              <text class="comment-time">{{item.time}}</text>
              <text class="comment-text">{{item.content}}</text>
            </view>
          </view>
          
          <view wx:if="{{item.comments.length > 2}}" class="view-more" bindtap="openComment" data-id="{{item.id}}">
            <text>查看全部{{item.comments.length}}条评论</text>
            <image src="/images/arrow_right.png" class="arrow-icon" />
          </view>
        </view>
      </view>
    </block>
  </view>
  
  <!-- 底部导航栏 -->
  <view class="student-nav">
    <view class="nav-item" bindtap="goToQuestionnaire">
      <image src="{{activeNav === 'questionnaire' ? '/images/nav_questionnaire_active.png' : '/images/nav_questionnaire.png'}}" class="nav-icon" />
      <text class="{{activeNav === 'questionnaire' ? 'nav-text active' : 'nav-text'}}">心理问卷</text>
    </view>
    
    <view class="nav-item" bindtap="goToAppointment">
      <image src="{{activeNav === 'appointment' ? '/images/nav_appointment_active.png' : '/images/nav_appointment.png'}}" class="nav-icon" />
      <text class="{{activeNav === 'appointment' ? 'nav-text active' : 'nav-text'}}">预约医生</text>
    </view>
  </view>
  
  <!-- 评论弹窗 -->
  <view wx:if="{{showCommentPopup}}" class="popup-mask">
    <view class="comment-popup">
      <view class="popup-header">
        <text>发表评论</text>
        <image src="/images/close.png" class="close-btn" bindtap="closeCommentPopup" />
      </view>
      <textarea 
        placeholder="写下您的评论..." 
        class="comment-input" 
        value="{{newComment}}"
        bindinput="onCommentInput"
        maxlength="200"
      ></textarea>
      <view class="popup-footer">
        <button class="cancel-btn" bindtap="closeCommentPopup">取消</button>
        <button class="submit-btn" bindtap="submitComment">提交</button>
      </view>
    </view>
  </view>
  
  <!-- 发帖弹窗 -->
  <view wx:if="{{showPostPopup}}" class="popup-mask">
    <view class="post-popup">
      <view class="popup-header">
        <text>分享您的体验</text>
        <image src="/images/close.png" class="close-btn" bindtap="closePostPopup" />
      </view>
      <textarea 
        placeholder="分享您的心理体验或感悟..." 
        class="post-input" 
        value="{{postContent}}"
        bindinput="onPostInput"
        maxlength="500"
      ></textarea>
      <view class="popup-tip">
        <image src="/images/shield.png" class="shield-icon" />
        <text>学生分享将自动匿名</text>
      </view>
      <view class="popup-footer">
        <button class="cancel-btn" bindtap="closePostPopup">取消</button>
        <button class="submit-btn" bindtap="submitPost">发布</button>
      </view>
    </view>
  </view>
  
  <!-- 底部提示 -->
  <view class="footer-tip">
    <image src="/images/icon_tip.png" class="tip-icon" />
    <text>这些小建议由专业心理咨询师提供，定期更新</text>
  </view>
</view>