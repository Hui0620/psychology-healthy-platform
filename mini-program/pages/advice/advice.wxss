/* health/pages/advice/advice.wxss */
.advice-container {
    padding: 20rpx;
    background-color: #f0f9ff;
    min-height: 100vh;
    padding-bottom: 130rpx; /* 为底部导航留出空间 */
  }
  
  .top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30rpx;
    padding: 20rpx;
    background-color: #ffffff;
    border-radius: 16rpx;
    box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  }
  
  .welcome {
    font-size: 36rpx;
    font-weight: bold;
    color: #1a73e8;
  }
  
  .post-btn {
    width: 40rpx;
    height: 40rpx;
  }
  
  .advice-list {
    margin-bottom: 30rpx;
  }
  
  .advice-card {
    background-color: white;
    border-radius: 16rpx;
    padding: 30rpx;
    margin-bottom: 30rpx;
    box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  }
  
  .card-header {
    margin-bottom: 20rpx;
    position: relative;
  }
  
  .category-tag {
    background-color: #e6f7ff;
    color: #1890ff;
    font-size: 22rpx;
    padding: 4rpx 12rpx;
    border-radius: 30rpx;
    display: inline-block;
    margin-bottom: 10rpx;
  }
  
  .title {
    font-size: 32rpx;
    font-weight: 600;
    color: #333;
    display: block;
    line-height: 1.5;
  }
  
  .card-content {
    margin-bottom: 25rpx;
  }
  
  .content {
    font-size: 28rpx;
    color: #555;
    line-height: 1.6;
    display: block;
  }
  
  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1rpx dashed #e0e0e0;
    padding-top: 20rpx;
  }
  
  .action {
    display: flex;
    flex-direction: column;
    align-items: center;
    color: #666;
    font-size: 26rpx;
    flex: 1;
  }
  
  .action-icon {
    width: 40rpx;
    height: 40rpx;
    margin-bottom: 8rpx;
  }
  
  .comments-preview {
    border-top: 1rpx dashed #eee;
    padding-top: 20rpx;
    margin-top: 20rpx;
  }
  
  .comment-item {
    display: flex;
    margin-bottom: 25rpx;
  }
  
  .comment-avatar {
    width: 60rpx;
    height: 60rpx;
    border-radius: 50%;
    margin-right: 15rpx;
  }
  
  .comment-content {
    flex: 1;
    border-radius: 12rpx;
    background-color: #f9f9f9;
    padding: 15rpx;
  }
  
  .comment-user {
    font-size: 26rpx;
    font-weight: 500;
    color: #333;
    margin-right: 15rpx;
  }
  
  .comment-time {
    font-size: 24rpx;
    color: #999;
  }
  
  .comment-text {
    display: block;
    font-size: 28rpx;
    color: #333;
    margin-top: 10rpx;
    line-height: 1.5;
  }
  
  .view-more {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #07c160;
    font-size: 28rpx;
    padding-top: 15rpx;
  }
  
  .arrow-icon {
    width: 30rpx;
    height: 30rpx;
    margin-left: 10rpx;
  }
  
  .footer-tip {
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 30rpx 0;
    font-size: 24rpx;
    color: #999;
  }
  
  .tip-icon {
    width: 28rpx;
    height: 28rpx;
    margin-right: 10rpx;
  }
  
  /* 底部导航样式 */
  .student-nav {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    height: 120rpx;
    background-color: white;
    display: flex;
    border-top: 1rpx solid #e0e0e0;
    box-shadow: 0 -4rpx 10rpx rgba(0, 0, 0, 0.05);
    z-index: 100;
  }
  
  .nav-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  
  .nav-icon {
    width: 50rpx;
    height: 50rpx;
    margin-bottom: 8rpx;
  }
  
  .nav-text {
    font-size: 24rpx;
    color: #666;
  }
  
  .nav-text.active {
    color: #07c160;
    font-weight: bold;
  }
  
  /* 弹窗样式 */
  .popup-mask {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.5);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 1000;
  }
  
  .comment-popup, .post-popup {
    width: 85%;
    max-height: 80vh;
    background-color: white;
    border-radius: 16rpx;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  
  .popup-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 25rpx 30rpx;
    background-color: #f8f8f8;
    border-bottom: 1rpx solid #eee;
    font-size: 32rpx;
    font-weight: bold;
  }
  
  .close-btn {
    width: 36rpx;
    height: 36rpx;
  }
  
  .comment-input, .post-input {
    flex: 1;
    min-height: 200rpx;
    padding: 25rpx;
    font-size: 28rpx;
    background-color: #fff;
    box-sizing: border-box;
  }
  
  .popup-footer {
    display: flex;
    justify-content: space-between;
    padding: 20rpx 30rpx;
    border-top: 1rpx solid #eee;
  }
  
  .cancel-btn, .submit-btn {
    height: 80rpx;
    line-height: 80rpx;
    border-radius: 8rpx;
    font-size: 28rpx;
    margin: 0;
  }
  
  .cancel-btn {
    background-color: #f8f8f8;
    color: #666;
    flex: 1;
    margin-right: 15rpx;
  }
  
  .submit-btn {
    background-color: #07c160;
    color: white;
    flex: 1;
  }
  
  .popup-tip {
    display: flex;
    align-items: center;
    padding: 15rpx 30rpx;
    background-color: #e6f7ff;
    color: #1890ff;
    font-size: 26rpx;
  }
  
  .shield-icon {
    width: 30rpx;
    height: 30rpx;
    margin-right: 10rpx;
  }