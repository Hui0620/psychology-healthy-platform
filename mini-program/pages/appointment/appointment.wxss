/* 预约医生页面样式 */
.appointment-container {
    padding: 30rpx;
    background-color: #f5f5f5;
    min-height: 100vh;
  }
  
  .header {
    display: flex;
    align-items: center;
    margin-bottom: 40rpx;
    padding-top: 40rpx;
  }
  
  .back-btn {
    width: 40rpx;
    height: 40rpx;
    margin-right: 20rpx;
  }
  
  .title {
    font-size: 40rpx;
    font-weight: bold;
    color: #333;
  }
  
  .doctor-list {
    margin-top: 20rpx;
  }
  
  .doctor-card {
    background-color: white;
    border-radius: 20rpx;
    padding: 30rpx;
    margin-bottom: 30rpx;
    display: flex;
    align-items: center;
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  }
  
  .doctor-avatar {
    width: 150rpx;
    height: 150rpx;
    border-radius: 50%;
    margin-right: 30rpx;
  }
  
  .doctor-info {
    flex: 1;
  }
  
  .doctor-header {
    display: flex;
    align-items: baseline;
    margin-bottom: 15rpx;
  }
  
  .doctor-name {
    font-size: 32rpx;
    font-weight: bold;
    margin-right: 15rpx;
  }
  
  .doctor-title {
    font-size: 26rpx;
    color: #666;
  }
  
  .doctor-specialty {
    font-size: 28rpx;
    color: #333;
    display: block;
    margin-bottom: 15rpx;
  }
  
  .doctor-rating {
    display: flex;
    align-items: center;
  }
  
  .rating-text {
    font-size: 26rpx;
    color: #666;
    margin-right: 15rpx;
  }
  
  .stars {
    display: flex;
  }
  
  .star {
    width: 30rpx;
    height: 30rpx;
    margin-right: 5rpx;
  }
  
  .appointment-status {
    align-self: flex-start;
  }
  
  .available {
    color: #07c160;
    font-size: 28rpx;
    font-weight: bold;
  }
  
  .unavailable {
    color: #999;
    font-size: 28rpx;
  }