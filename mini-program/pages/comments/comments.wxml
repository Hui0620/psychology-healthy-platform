<!-- pages/comments/comments.wxml -->
<view class="comments-container">
  <view class="header">
    <view class="back-btn" bindtap="navigateBack">
      <image src="/images/back.png" mode="aspectFit" />
    </view>
    <text class="title">{{studentName}}的评论</text>
  </view>

  <!-- 评论输入框 -->
  <view class="comment-input-area">
    <textarea 
      value="{{newComment}}" 
      bindinput="onCommentInput" 
      placeholder="请留下您的匿名评论（最多200字）" 
      maxlength="200" 
      class="comment-textarea"
    ></textarea>
    <view class="comment-submit-area">
      <text class="char-count">{{newComment.length}}/200</text>
      <button 
        bindtap="submitComment" 
        class="submit-btn"
        disabled="{{!newComment.trim()}}"
      >提交评论</button>
    </view>
  </view>
  
  <!-- 评论列表 -->
  <view class="comment-list">
    <view class="section-title">
      <image src="/images/history.png" class="icon" />
      <text>历史评论</text>
    </view>
    
    <block wx:for="{{comments}}" wx:key="timestamp">
      <view class="comment-item">
        <view class="comment-header">
          <image src="/images/anonymous.png" class="anonymous-icon" />
          <text class="comment-time">{{formatTime(item.timestamp)}}</text>
        </view>
        <view class="comment-content">{{item.content}}</view>
        <view class="comment-status {{item.status === 'pending' ? 'pending' : 'approved'}}">
          {{item.status === 'pending' ? '审核中' : '已公开'}}
        </view>
      </view>
    </block>
    
    <view wx:if="{{comments.length === 0}}" class="empty-comments">
      <image src="/images/empty.png" class="empty-icon" />
      <text>暂无评论，快来发表第一条吧</text>
    </view>
  </view>
</view>