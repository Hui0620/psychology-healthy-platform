.community-container {
    padding: 30rpx;
    padding-bottom: 120rpx;
    background-color: #f8f8f8;
    min-height: 100vh;
  }
  
  .search-bar {
    position: relative;
    margin-bottom: 30rpx;
  }
  
  .search-input {
    background-color: #fff;
    height: 80rpx;
    border-radius: 40rpx;
    padding: 0 40rpx 0 25rpx;
    font-size: 28rpx;
    box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.05);
  }
  
  .search-icon {
    position: absolute;
    right: 25rpx;
    top: 25rpx;
    width: 40rpx;
    height: 40rpx;
  }
  
  .category-tabs {
    display: flex;
    flex-wrap: wrap;
    margin-bottom: 25rpx;
  }
  
  .tab-item {
    background: #fff;
    padding: 10rpx 30rpx;
    margin-right: 20rpx;
    margin-bottom: 15rpx;
    border-radius: 40rpx;
    font-size: 26rpx;
    color: #666;
    box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
  }
  
  .tab-item.active {
    background: #07c160;
    color: #fff;
    font-weight: bold;
  }
  
  .posts-list {
    margin-bottom: 40rpx;
  }
  
  .post-card {
    background: #fff;
    border-radius: 16rpx;
    padding: 30rpx;
    margin-bottom: 30rpx;
    box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.05);
  }
  
  .post-header {
    display: flex;
    align-items: center;
    margin-bottom: 25rpx;
  }
  
  .avatar {
    width: 80rpx;
    height: 80rpx;
    border-radius: 50%;
    margin-right: 20rpx;
  }
  
  .user-info {
    flex: 1;
  }
  
  .username {
    font-size: 30rpx;
    font-weight: bold;
    color: #333;
    margin-right: 15rpx;
  }
  
  .role-tag {
    background: #e6f7ff;
    color: #1890ff;
    font-size: 22rpx;
    padding: 2rpx 10rpx;
    border-radius: 8rpx;
    margin-right: 15rpx;
  }
  
  .post-time {
    font-size: 24rpx;
    color: #999;
  }
  
  .post-title {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
    margin-bottom: 20rpx;
    display: block;
  }
  
  .post-content {
    font-size: 28rpx;
    color: #555;
    line-height: 1.6;
    margin-bottom: 25rpx;
    display: block;
  }
  
  .post-footer {
    display: flex;
    border-top: 1rpx solid #eee;
    padding-top: 25rpx;
  }
  
  .action {
    display: flex;
    align-items: center;
    margin-right: 40rpx;
  }
  
  .action-icon {
    width: 36rpx;
    height: 36rpx;
    margin-right: 8rpx;
  }
  
  .compose-btn {
    position: fixed;
    right: 40rpx;
    bottom: 100rpx;
    background: #07c160;
    color: white;
    border-radius: 50rpx;
    padding: 20rpx 30rpx;
    font-size: 28rpx;
    display: flex;
    align-items: center;
    box-shadow: 0 8rpx 20rpx rgba(7, 193, 96, 0.3);
    z-index: 100;
  }
  
  .compose-icon {
    width: 40rpx;
    height: 40rpx;
    margin-right: 10rpx;
  }