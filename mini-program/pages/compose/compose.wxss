.compose-container {
    padding: 30rpx;
    background-color: #f8f8f8;
    min-height: 100vh;
  }
  
  .form-item {
    background-color: white;
    border-radius: 12rpx;
    padding: 20rpx 30rpx;
    margin-bottom: 30rpx;
    box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
  }
  
  .title-input {
    font-size: 32rpx;
    min-height: 60rpx;
  }
  
  .content-input {
    min-height: 400rpx;
    font-size: 28rpx;
    line-height: 1.6;
    width: 100%;
  }
  
  .image-picker {
    background-color: white;
    border-radius: 12rpx;
    padding: 20rpx 30rpx;
    margin-bottom: 30rpx;
    box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
  }
  
  .tip {
    font-size: 26rpx;
    color: #666;
    display: block;
    margin-bottom: 20rpx;
  }
  
  .images-container {
    display: flex;
    flex-wrap: wrap;
    margin-top: 20rpx;
  }
  
  .image-preview {
    width: 200rpx;
    height: 200rpx;
    border-radius: 12rpx;
    margin-right: 20rpx;
    margin-bottom: 20rpx;
    position: relative;
  }
  
  .image {
    width: 100%;
    height: 100%;
    border-radius: 12rpx;
  }
  
  .close {
    position: absolute;
    top: -12rpx;
    right: -12rpx;
    width: 40rpx;
    height: 40rpx;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 10rpx rgba(0,0,0,0.1);
  }
  
  .add-btn {
    width: 200rpx;
    height: 200rpx;
    border: 1rpx dashed #ccc;
    border-radius: 12rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: #999;
    font-size: 26rpx;
  }
  
  .camera-icon {
    width: 50rpx;
    height: 50rpx;
    margin-bottom: 15rpx;
  }
  
  .category-picker {
    font-size: 28rpx;
  }
  
  .picker-label {
    display: flex;
    align-items: center;
  }
  
  .category-name {
    color: #07c160;
    margin-left: 15rpx;
  }
  
  .anonymous-tip {
    display: flex;
    align-items: center;
    background-color: #e6f7ff;
    border-radius: 12rpx;
    padding: 15rpx 20rpx;
    margin-bottom: 30rpx;
    font-size: 26rpx;
    color: #1890ff;
  }
  
  .shield-icon {
    width: 36rpx;
    height: 36rpx;
    margin-right: 10rpx;
  }
  
  .submit-btn {
    background-color: #07c160;
    color: white;
    border-radius: 50rpx;
    margin-top: 30rpx;
    height: 90rpx;
    line-height: 90rpx;
    font-size: 32rpx;
  }
  
  .submit-btn::after {
    border: none;
  }