<view class="questionnaire-container">
  <!-- 顶部进度条 -->
  <view class="progress-container">
    <text class="progress-text">完成进度: {{completed}}/{{totalQuestions}}</text>
    <view class="progress-bar">
      <view class="progress-inner" style="width: {{(completed/totalQuestions)*100}}"></view>
    </view>
  </view>
  
  <!-- 问卷题目区域 -->
  <view class="question-content">
    <!-- 问题标题栏 -->
    <view class="question-header">
      <text class="question-index">问题{{currentIndex+1}}</text>
      <view class="question-meta">
        <image src="/images/time-icon.png" class="meta-icon" />
        <text>{{questionTime}}分钟</text>
      </view>
    </view>
    
    <!-- 问题文本 -->
    <view class="question-text">
      {{currentQuestion.text}}
    </view>
    
    <!-- 选项区域 -->
    <view class="options-container">
      <block wx:for="{{currentQuestion.options}}" wx:key="id">
        <view 
          class="option-item {{currentQuestion.selected === item.id ? 'option-selected' : ''}}" 
          bindtap="selectOption"
          data-option-id="{{item.id}}"
        >
          <text class="option-text">{{item.text}}</text>
        </view>
      </block>
    </view>
  </view>
  
  <!-- 导航按钮 -->
  <view class="navigation-buttons">
    <button 
      class="nav-btn prev-btn" 
      bindtap="prevQuestion"
      disabled="{{currentIndex === 0}}"
    >上一题</button>
    
    <button 
      class="nav-btn next-btn" 
      bindtap="nextQuestion"
      disabled="{{!currentQuestion.selected}}"
      wx:if="{{currentIndex < questions.length - 1}}"
    >下一题</button>
    
    <button 
      class="nav-btn submit-btn" 
      bindtap="submitQuestionnaire"
      disabled="{{!currentQuestion.selected}}"
      wx:if="{{currentIndex === questions.length - 1}}"
    >提交问卷</button>
  </view>
</view>